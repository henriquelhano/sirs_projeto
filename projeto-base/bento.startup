mkdir -p /dev/net
mknod /dev/net/tun c 10 200
chmod 600 /dev/net/tun

ifconfig eth0 6.6.6.200/24 up
ip route add 3.2.0.0/20 via 6.6.6.1
ip route add 7.4.3.0/24 via 6.6.6.2

while [ ! -f /shared/ca.crt ] || [ ! -f /shared/bento.crt ] || [ ! -f /shared/bento.key ] || [ ! -f /shared/ta.key ]; do
    sleep 2
done

cp /shared/ca.crt /etc/openvpn/
cp /shared/bento.crt /etc/openvpn/
cp /shared/bento.key /etc/openvpn/
cp /shared/ta.key /etc/openvpn/

openvpn --config /etc/openvpn/client-bento.conf --daemon
